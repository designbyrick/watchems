# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Upstash Redis (voting, rate limiting — NOT photo metadata)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Neon Postgres (photo metadata and moderation status)
DATABASE_URL=postgresql://user:password@host/database

# Cloudflare R2 (photo file storage) — optional, falls back to local filesystem
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://your-bucket.cdn.example.com

# Admin access — comma-separated Clerk user IDs for /admin routes
# CRITICAL: if not set, admin routes are locked to everyone
ADMIN_USER_IDS=user_abc123,user_def456
# Legacy single admin (still works, merged with ADMIN_USER_IDS)
# ADMIN_USER_ID=user_...

# Brevo (formerly Sendinblue) — marketing automation on photo approval
BREVO_API_KEY=
BREVO_LIST_ID=

# Resend — transactional email (photo approval notifications)
RESEND_API_KEY=
# Optional: set to send from your domain (e.g. "Watchems <hello@watchems.com>")
# Requires domain verification in Resend dashboard. Falls back to onboarding@resend.dev
RESEND_FROM_EMAIL=

# Cron jobs (/api/cron/*) — Vercel sends "Authorization: Bearer $CRON_SECRET" automatically
# when this var is set on the project. Without it, cron routes return 401 in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional: PageSpeed Insights API key (Core Web Vitals cron). Without it, the shared
# anonymous quota often returns 429.
PAGESPEED_API_KEY=
# Optional: Google Search Console service account (raw JSON or base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sentry error monitoring — optional. Without the DSNs Sentry stays off (no-op).
# DSN: Sentry → Project Settings → Client Keys (DSN). Same value for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time — optional, only used when the token is set.
# Token: Sentry → Settings → Auth Tokens (org token with project:releases scope).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
