{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "crons": [
    { "path": "/api/cron/core-web-vitals", "schedule": "0 2 * * *" },
    { "path": "/api/cron/gsc-metrics", "schedule": "0 3 * * 1" },
    { "path": "/api/cron/image-health", "schedule": "0 9 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "clerk.watchems.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
